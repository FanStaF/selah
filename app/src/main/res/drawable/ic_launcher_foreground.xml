<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: an angled Bible drawn as a yellow OUTLINE with a filled yellow cross,
     over the brand-blue background. Two brand colors only: blue #1E3A5F bg, yellow #F8E808. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:name="book"
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-12">
        <!-- cover outline -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#F8E808"
            android:strokeWidth="3.5"
            android:strokeLineJoin="round"
            android:pathData="M40,26 h28 a4,4 0 0 1 4,4 v48 a4,4 0 0 1 -4,4 h-28 a4,4 0 0 1 -4,-4 v-48 a4,4 0 0 1 4,-4 z" />
        <!-- spine -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#F8E808"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M43,29 v50" />
        <!-- cross (filled), centered on the cover face (right of the spine, ~x58) -->
        <path
            android:fillColor="#F8E808"
            android:pathData="M55,40 h6 v8 h6 v6 h-6 v16 h-6 v-16 h-6 v-6 h6 z" />
    </group>
</vector>
