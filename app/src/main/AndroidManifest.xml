<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Draw the verse overlay after unlock. Also grants the background-activity-start exemption,
         though we draw directly rather than launching an Activity. User grants this in Settings. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Keep a process alive to receive ACTION_USER_PRESENT (which is NOT an exempted implicit
         broadcast, so the receiver must be registered at runtime by a running service). No natural
         FGS type fits "keep a receiver alive," so we use specialUse (declared for Play review). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Restart the service after a reboot (BOOT_COMPLETED *is* an exempted broadcast). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The ongoing foreground-service notification (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SelahApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Selah"
        tools:targetApi="26">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Selah">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.UnlockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Detects device unlock (ACTION_USER_PRESENT) to briefly show a Bible verse overlay for memorization, then dismisses. No lock-screen replacement; access is never blocked." />
        </service>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
